[
  {"id": "avi-001", "term": "起飛", "termEn": "takeoff", "definition": "航空器離開地面升空的過程", "context": "準備起飛", "domain": "aviation"},
  {"id": "avi-002", "term": "降落", "termEn": "landing", "definition": "航空器從空中返回地面的過程", "domain": "aviation"},
  {"id": "avi-003", "term": "跑道", "termEn": "runway", "definition": "供航空器起飛和降落的長條形地面設施", "context": "跑道 28L 已清空", "domain": "aviation"},
  {"id": "avi-004", "term": "滑行道", "termEn": "taxiway", "definition": "連接跑道與停機坪、供航空器地面滑行的通道", "domain": "aviation"},
  {"id": "avi-005", "term": "塔台", "termEn": "control tower (TWR)", "definition": "機場負責管制起降和地面交通的管制單位", "domain": "aviation"},
  {"id": "avi-006", "term": "航管", "termEn": "air traffic control (ATC)", "definition": "負責管理空域內航空器安全運行的地面服務", "domain": "aviation"},
  {"id": "avi-007", "term": "飛行計畫", "termEn": "flight plan", "definition": "飛行員或航空公司向航管單位提交的飛行路線和資訊", "domain": "aviation"},
  {"id": "avi-008", "term": "巡航高度", "termEn": "cruising altitude", "definition": "航空器在平飛階段維持的飛行高度", "context": "巡航高度三萬五千呎", "domain": "aviation"},
  {"id": "avi-009", "term": "飛行空層", "termEn": "flight level (FL)", "definition": "以標準大氣壓為基準的飛行高度表示法，如 FL350 表示 35,000 呎", "domain": "aviation"},
  {"id": "avi-010", "term": "空速", "termEn": "airspeed", "definition": "航空器相對於周圍空氣的速度", "domain": "aviation"},
  {"id": "avi-011", "term": "地速", "termEn": "ground speed", "definition": "航空器相對於地面的速度", "domain": "aviation"},
  {"id": "avi-012", "term": "節", "termEn": "knot (kt)", "definition": "航空和航海速度單位，等於每小時一海浬", "domain": "aviation"},
  {"id": "avi-013", "term": "馬赫數", "termEn": "Mach number", "definition": "航空器速度與音速的比值", "context": "巡航馬赫數 0.82", "domain": "aviation"},
  {"id": "avi-014", "term": "航向", "termEn": "heading", "definition": "航空器機頭所指的方向，以磁北為基準的角度", "domain": "aviation"},
  {"id": "avi-015", "term": "航路", "termEn": "airway", "definition": "空中劃定的固定飛行路線", "domain": "aviation"},
  {"id": "avi-016", "term": "進場", "termEn": "approach", "definition": "航空器準備降落時依照規定路線和程序接近機場跑道", "domain": "aviation"},
  {"id": "avi-017", "term": "離場", "termEn": "departure", "definition": "航空器起飛後依照規定路線離開機場空域", "domain": "aviation"},
  {"id": "avi-018", "term": "等待航線", "termEn": "holding pattern", "definition": "航空器在指定空域內繞圈飛行等待進場許可", "context": "進入等待航線", "domain": "aviation"},
  {"id": "avi-019", "term": "儀器降落系統", "termEn": "instrument landing system (ILS)", "definition": "利用無線電引導航空器精確對準跑道降落的系統", "domain": "aviation"},
  {"id": "avi-020", "term": "目視飛行", "termEn": "visual flight rules (VFR)", "definition": "飛行員以目視參照地面和天空來操控航空器的飛行規則", "domain": "aviation"},
  {"id": "avi-021", "term": "儀器飛行", "termEn": "instrument flight rules (IFR)", "definition": "飛行員主要依靠機上儀器和航管指引飛行的規則", "domain": "aviation"},
  {"id": "avi-022", "term": "重飛", "termEn": "go-around / missed approach", "definition": "進場過程中放棄降落、重新爬升的程序", "context": "執行重飛", "domain": "aviation"},
  {"id": "avi-023", "term": "備降", "termEn": "diversion", "definition": "因故無法在原定機場降落而轉降其他機場", "domain": "aviation"},
  {"id": "avi-024", "term": "襟翼", "termEn": "flaps", "definition": "機翼後緣可調整角度的活動面，用於增加升力或阻力", "context": "襟翼放到 30 度", "domain": "aviation"},
  {"id": "avi-025", "term": "起落架", "termEn": "landing gear", "definition": "航空器用於起飛、降落和地面滑行的輪組結構", "domain": "aviation"},
  {"id": "avi-026", "term": "自動駕駛", "termEn": "autopilot", "definition": "自動控制航空器飛行姿態和航向的系統", "domain": "aviation"},
  {"id": "avi-027", "term": "飛行管理系統", "termEn": "flight management system (FMS)", "definition": "整合導航、性能和飛行計畫的機載電腦系統", "domain": "aviation"},
  {"id": "avi-028", "term": "黑盒子", "termEn": "flight data recorder (FDR) / cockpit voice recorder (CVR)", "definition": "記錄飛行數據和駕駛艙語音的防撞記錄器", "domain": "aviation"},
  {"id": "avi-029", "term": "氣象報告", "termEn": "METAR", "definition": "機場定期發布的例行天氣觀測報告", "domain": "aviation"},
  {"id": "avi-030", "term": "天氣預報", "termEn": "TAF (terminal aerodrome forecast)", "definition": "機場終端區域的天氣預報", "domain": "aviation"},
  {"id": "avi-031", "term": "風切", "termEn": "wind shear", "definition": "短距離內風速或風向的劇烈變化，對飛行安全構成威脅", "domain": "aviation"},
  {"id": "avi-032", "term": "亂流", "termEn": "turbulence", "definition": "大氣中不規則的氣流擾動，造成航空器顛簸", "context": "預計前方有中度亂流", "domain": "aviation"},
  {"id": "avi-033", "term": "能見度", "termEn": "visibility", "definition": "在特定大氣條件下能清楚看到物體的最大水平距離", "domain": "aviation"},
  {"id": "avi-034", "term": "雲幕高", "termEn": "ceiling", "definition": "最低雲層覆蓋天空超過一半時的高度", "domain": "aviation"},
  {"id": "avi-035", "term": "通話頻率", "termEn": "communication frequency", "definition": "航空器與地面單位通訊使用的無線電頻率", "context": "轉換頻率 121.5", "domain": "aviation"},
  {"id": "avi-036", "term": "應答機", "termEn": "transponder", "definition": "接收地面雷達詢問並回傳識別和高度資訊的機載設備", "domain": "aviation"},
  {"id": "avi-037", "term": "近地警告系統", "termEn": "ground proximity warning system (GPWS)", "definition": "偵測航空器異常接近地面時發出警告的安全系統", "domain": "aviation"},
  {"id": "avi-038", "term": "空中防撞系統", "termEn": "traffic collision avoidance system (TCAS)", "definition": "偵測附近航空器並提供避撞建議的機載系統", "domain": "aviation"},
  {"id": "avi-039", "term": "燃油量", "termEn": "fuel quantity", "definition": "航空器攜帶的燃油總量，通常以磅或公斤計", "domain": "aviation"},
  {"id": "avi-040", "term": "航程", "termEn": "range", "definition": "航空器在不加油情況下能飛行的最大距離", "domain": "aviation"},
  {"id": "avi-041", "term": "酬載", "termEn": "payload", "definition": "航空器可載運的旅客、貨物和行李的總重量", "domain": "aviation"},
  {"id": "avi-042", "term": "最大起飛重量", "termEn": "maximum takeoff weight (MTOW)", "definition": "航空器允許起飛的最大總重量", "domain": "aviation"},
  {"id": "avi-043", "term": "適航證", "termEn": "airworthiness certificate", "definition": "證明航空器符合安全飛行標準的官方文件", "domain": "aviation"},
  {"id": "avi-044", "term": "航線維修", "termEn": "line maintenance", "definition": "航班間於停機坪執行的例行檢查和簡易維修", "domain": "aviation"},
  {"id": "avi-045", "term": "定期檢修", "termEn": "scheduled maintenance / heavy check", "definition": "按照飛行時數或日曆間隔執行的深度維修檢查，如 A/B/C/D check", "domain": "aviation"},
  {"id": "avi-046", "term": "簽派", "termEn": "dispatch", "definition": "航空公司負責飛行計畫、航路規劃和飛行監控的部門", "domain": "aviation"},
  {"id": "avi-047", "term": "機長", "termEn": "captain / pilot in command (PIC)", "definition": "航空器上負責飛行安全的最高指揮官", "domain": "aviation"},
  {"id": "avi-048", "term": "副駕駛", "termEn": "first officer (FO) / co-pilot", "definition": "協助機長操控航空器的飛行員", "domain": "aviation"},
  {"id": "avi-049", "term": "飛行時數", "termEn": "flight hours", "definition": "飛行員或航空器累計的飛行操作時間", "domain": "aviation"},
  {"id": "avi-050", "term": "緊急宣告", "termEn": "emergency declaration (Mayday / Pan-Pan)", "definition": "航空器遇到緊急或危急狀況時向航管發出的求援通訊", "context": "Mayday Mayday Mayday", "domain": "aviation"}
