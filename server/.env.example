# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# Gemini Live Model (可選，預設 gemini-3-flash-preview)
# 支援的模型：gemini-3-flash-preview, gemini-2.0-flash-exp
# 若指定的模型不支援，會自動 fallback 到 gemini-2.0-flash-exp
GEMINI_LIVE_MODEL=gemini-3-flash-preview

# Gemini Voice (可選，預設 Kore)
# 支援的語音：Puck, Charon, Kore, Fenrir, Aoede
GEMINI_VOICE=Kore

# 預設語言設定
SOURCE_LANG=zh-TW
TARGET_LANG=en

# 預設 Provider (openai 或 gemini)
REALTIME_PROVIDER=gemini
