{
    "name": "realtime-client",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "electron:compile": "tsc -p electron/tsconfig.json",
        "electron:dev": "npm run electron:compile && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron dist-electron/main.js\"",
        "electron:build": "npm run build && npm run electron:compile && electron-builder",
        "electron:preview": "npm run electron:compile && electron dist-electron/main.js"
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "socket.io-client": "^4.7.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.13.0",
        "@testing-library/react": "^14.1.2",
        "@testing-library/user-event": "^14.5.1",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.3",
        "@vitest/ui": "^1.0.4",
        "concurrently": "^9.2.1",
        "electron": "^41.1.0",
        "electron-builder": "^26.8.1",
        "eslint": "^9.13.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.14",
        "globals": "^15.11.0",
        "jsdom": "^23.0.1",
        "typescript": "~5.6.2",
        "typescript-eslint": "^8.11.0",
        "vite": "^5.4.10",
        "vitest": "^1.0.4",
        "wait-on": "^9.0.4"
    },
    "build": {
        "appId": "com.realtime-lab.meeting-assistant",
        "productName": "會議小幫手",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*"
        ],
        "mac": {
            "category": "public.app-category.productivity",
            "target": "dmg"
        }
    }
}
